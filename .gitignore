# .gitignore ── 版本控制排除清單
# 請將此檔案放在專案根目錄

# ── API 金鑰（絕對不能上傳）─────────────────────────────────────────────────
.env

# ── Python 快取 ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── 暫存 PDF（pipeline 執行中產生，執行完會自動刪除）────────────────────────
temp_cropped_optimized.pdf

# ── 大型輸出檔（圖片、ZIP、Word）────────────────────────────────────────────
extracted_formulas_mfd/
extracted_formulas_mfd-2/
AI_圖片處理_正式版/
previews/
*.zip
*_已轉檔.docx

# ── 原始 PDF（通常很大，不 commit）──────────────────────────────────────────
待提取公式檔案/*.pdf

# Data directories
data/
