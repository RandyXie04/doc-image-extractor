# =============================================================================
# .env.example ── 環境設定範本
# 使用方式：將此檔案複製為 .env，並填入你的實際金鑰
#   cp .env.example .env
# 注意：.env 絕對不能上傳至 Git（已加入 .gitignore）
# =============================================================================

# -----------------------------------------------------------------------------
# 【AI 模型 API 金鑰】
# -----------------------------------------------------------------------------

# OpenAI (GPT-4o、GPT-4 Vision 等)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek (推薦用於標題語義判定，成本最低)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 其他自訂模型端點（可選）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# -----------------------------------------------------------------------------
# 【AI 行為設定】（不含路徑，路徑由 config.py 的 pathlib 動態計算）
# -----------------------------------------------------------------------------

# 預設呼叫的 AI 模型名稱
DEFAULT_AI_MODEL=

# OCR / 公式辨識是否使用 GPU（true / false）
USE_GPU=true

# 公式截圖渲染 DPI
FORMULA_DPI=300

# PDF 頁眉/頁尾探測比例
HEADER_RATIO=0.15
FOOTER_RATIO=0.92

# EasyOCR 語言設定（逗號分隔）
EASYOCR_LANGS=ch_sim,en

# -----------------------------------------------------------------------------
# 【AI 標題語義判定】
# -----------------------------------------------------------------------------

# 是否啟用 AI 輔助標題判定（true / false）
AI_HEADING_ENABLED=false

# AI 提供者（deepseek / openai / custom）
AI_HEADING_PROVIDER=deepseek

# AI 模型名稱
AI_HEADING_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# 【AI 楷體段落辨識 (Gemini Vision)】
# 使用 Gemini 3.1 Pro Vision 從 PDF 截圖辨識楷體/宋體/黑體字型
# 需要設定 GEMINI_API_KEY
# -----------------------------------------------------------------------------

# 是否啟用 AI 輔助楷體段落辨識（true / false）
AI_KAITI_ENABLED=false

# AI 楷體辨識模型
AI_KAITI_MODEL=gemini-3.1-pro-preview
