# =============================================================================
# .env.example ── 環境設定範本
# 使用方式：將此檔案複製為 .env，並填入你的實際金鑰
#   cp .env.example .env
# 注意：.env 絕對不能上傳至 Git（已加入 .gitignore）
# =============================================================================

# -----------------------------------------------------------------------------
# 【AI 模型 API 金鑰】
# -----------------------------------------------------------------------------

# OpenAI (GPT-4o、GPT-4 Vision 等)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 其他自訂模型端點（可選）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# -----------------------------------------------------------------------------
# 【AI 行為設定】（不含路徑，路徑由 config.py 的 pathlib 動態計算）
# -----------------------------------------------------------------------------

# 預設呼叫的 AI 模型名稱
DEFAULT_AI_MODEL=gpt-4o

# OCR / 公式辨識是否使用 GPU（true / false）
USE_GPU=true

# 公式截圖渲染 DPI
FORMULA_DPI=300

# PDF 頁眉/頁尾探測比例
HEADER_RATIO=0.15
FOOTER_RATIO=0.92

# EasyOCR 語言設定（逗號分隔）
EASYOCR_LANGS=ch_sim,en
